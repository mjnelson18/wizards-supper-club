{
  "name": "wizards-supper-club",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Read-only record of every Wizards supper club evening, built from the group's Google Sheet.",
  "scripts": {
    "dev": "vite",
    "data": "tsx scripts/fetch-data.ts",
    "data:sample": "tsx scripts/fetch-data.ts --sample",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:known": "vitest run --config vitest.known.config.ts",
    "build": "tsc --noEmit && vite build",
    "check:dist": "node scripts/check-dist.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
